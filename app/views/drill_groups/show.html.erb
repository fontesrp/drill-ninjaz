<div class="container">
  <div class="row">
    <div class="col-8">
      <h1><%= @drill_group.name %></h1>
    </div>
    <div class="col-4">
      <%= link_to 'Edit Group', edit_drill_group_path(@drill_group) %>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <p><%= @drill_group.description %></p>
    </div>
  </div>
</div>

<div class="container">
  <% @drill_group.questions.each do |question| %>
    <div class="row">
      <div class="col-8">
        <p>Drill: <%= question.description %></p>
      </div>
      <div class="col-4">
        <%= link_to 'Edit', edit_drill_group_question_path(@drill_group, question) %>
        <%= link_to 'Delete', drill_group_question_path(@drill_group, question), method: :delete %>
      </div>
    </div>
  <% end %>
</div>

<div class="container">
  <h5>Add New Drill</h5>
  <%= render 'questions/form' %>
</div>
